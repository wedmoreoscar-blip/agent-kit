#!/usr/bin/env python3
"""Run a verification profile defined in docs/project_profile.md.

    tools/test-project <profile>       e.g. quick, build, full
    tools/test-project --list

Each profile is a list of command names from [commands]. Every command runs from the repository
root, even if one fails, and the exit status is non-zero if any failed. A command's output is shown
in full: read the failures, not only the PASS/FAIL line.
"""
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import agent_profile  # noqa: E402

try:
    data = agent_profile.load()
except agent_profile.ProfileError as exc:
    agent_profile.die(f"test-project: {exc}")
profiles = data.get("profiles", {})

if len(sys.argv) != 2:
    agent_profile.die("Usage: tools/test-project <profile> | --list", 64)
if sys.argv[1] == "--list":
    for name, steps in profiles.items():
        print(f"{name}: {', '.join(steps)}")
    sys.exit(0)
name = sys.argv[1]
if name not in profiles:
    agent_profile.die(f"Unknown profile {name!r}. Defined: {', '.join(profiles) or 'none'}", 64)

status = 0
for step in profiles[name]:
    command = data["commands"][step]
    print(f"RUN  {step}: {command}", flush=True)
    code = subprocess.run(command, shell=True, cwd=agent_profile.ROOT).returncode
    if code == 0:
        print(f"PASS {step}", flush=True)
    else:
        print(f"FAIL {step} (exit {code})", file=sys.stderr, flush=True)
        status = 1
sys.exit(status)
