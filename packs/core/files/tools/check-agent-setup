#!/usr/bin/env python3
"""Validate this repository's agent setup without modifying it.

Works on any machine and needs no orchestration tool installed. What it checks comes from the
repository itself: `.agent-kit.lock` (written by the agent kit) names the skill targets and packs,
and packs may add checks as `tools/check_agent_setup_*.py` modules exposing `check(root, fail)`.
"""
from __future__ import annotations

import importlib.util
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "tools"))
import agent_profile  # noqa: E402

TARGET_DIRS = {
    "agents": ".agents/skills", "claude": ".claude/skills", "cursor": ".cursor/skills",
    "grok": ".grok/skills", "kimi": ".kimi-code/skills", "kiro": ".kiro/skills",
    "droid": ".factory/skills", "qwen": ".qwen/skills",
}
REQUIRED = ["AGENTS.md", "CLAUDE.md", ".codex/config.toml", ".claude/settings.json", "opencode.json",
            "docs/project_profile.md", "docs/decisions.md", "docs/delegation_spend.md",
            "docs/workflows/delegation.md", "tasks/next_session_kickoff.md"]
EXECUTABLE = ["tools/agent-lock", "tools/check-agent-setup", "tools/prepare-worktree",
              "tools/spec-block", "tools/spend-guard", "tools/test-project", "tools/writespec-guard"]


def fail(message: str, failures: list[str]) -> None:
    failures.append(message)
    print(f"FAIL {message}")


def receipt() -> dict:
    path = ROOT / ".agent-kit.lock"
    if path.is_file():
        try:
            return json.loads(path.read_text())
        except json.JSONDecodeError:
            return {}
    return {}


def parse_skill(path: Path, expected: str, failures: list[str]) -> None:
    text = path.read_text()
    match = re.match(r"^---\n(.*?)\n---\n", text, re.DOTALL)
    if not match:
        fail(f"{path.relative_to(ROOT)} has invalid frontmatter", failures)
        return
    fields: dict[str, str] = {}
    for line in match.group(1).splitlines():
        if ":" not in line:
            fail(f"{path.relative_to(ROOT)} has malformed frontmatter", failures)
            return
        key, value = line.split(":", 1)
        fields[key.strip()] = value.strip()
    if set(fields) != {"name", "description"}:
        fail(f"{path.relative_to(ROOT)} must contain only name and description", failures)
    if fields.get("name") != expected:
        fail(f"{path.relative_to(ROOT)} name does not match its directory", failures)
    if not fields.get("description"):
        fail(f"{path.relative_to(ROOT)} has an empty description", failures)


def tree_bytes(directory: Path) -> dict[str, bytes]:
    return {str(p.relative_to(directory)): p.read_bytes()
            for p in sorted(directory.rglob("*")) if p.is_file()}


def check_skills(targets: list[str], failures: list[str]) -> int:
    roots = {t: ROOT / TARGET_DIRS[t] for t in targets if t in TARGET_DIRS}
    names = {t: {p.name for p in r.iterdir() if p.is_dir()} if r.is_dir() else set()
             for t, r in roots.items()}
    union = set().union(*names.values()) if names else set()
    for target, found in names.items():
        if found != union:
            fail(f"{TARGET_DIRS[target]} is missing skills {sorted(union - found)}", failures)
    reference = roots.get("agents") or next(iter(roots.values()))
    for name in sorted(union):
        for target, root in roots.items():
            skill = root / name / "SKILL.md"
            if skill.is_file():
                parse_skill(skill, name, failures)
        trees = {t: tree_bytes(r / name) for t, r in roots.items() if (r / name).is_dir()}
        first = trees.get("agents") or next(iter(trees.values()))
        for target, tree in trees.items():
            if tree != first:
                fail(f"skill drift: {TARGET_DIRS[target]}/{name} differs from "
                     f"{reference.relative_to(ROOT)}/{name}", failures)
        if "agents" in roots and not (roots["agents"] / name / "agents/openai.yaml").is_file():
            fail(f"missing Codex UI metadata .agents/skills/{name}/agents/openai.yaml", failures)
    return len(union)


def guard_decision(guard: Path, payload: dict, env: dict | None = None) -> bool:
    result = subprocess.run([str(guard)], input=json.dumps(payload), capture_output=True,
                            text=True, check=False, cwd=ROOT, env=env)
    return "permissionDecision" in result.stdout


def check_writespec_guard(failures: list[str]) -> None:
    """Native subagent commissions are governed; exploration subagents and markers pass."""
    guard = ROOT / "tools/writespec-guard"
    try:
        blocks = "".join(agent_profile.render_block(n) for n in ("baseline", "scope", "closing"))
        checker_only = agent_profile.checker_only_commands()
    except agent_profile.ProfileError as exc:
        fail(f"writespec-guard regression skipped: {exc}", failures)
        return

    def agent(prompt: str, isolation: str | None = "worktree") -> dict:
        tool_input = {"prompt": prompt, "description": "x"}
        if isolation:
            tool_input["isolation"] = isolation
        return {"tool_name": "Agent", "tool_input": tool_input, "cwd": str(ROOT)}

    cases = [
        (agent("Explore the repo and report", isolation=None), False),
        (agent("[no-spec] stand down"), False),
        (agent("[visual-check] go look at the screens"), False),
        (agent("Build the thing"), True),
        (agent("Spec: change foo.\n" + blocks), False),
        (agent("Spec: change foo. Then add new unit tests for it.\n" + blocks), True),
        ({"tool_name": "Bash", "tool_input": {"command": "ls"}}, False),
    ]
    if checker_only:
        cases.append((agent(f"Spec.\nRun these from the root:\n- `{checker_only[0]}`\n" + blocks), True))
    for payload, should_deny in cases:
        if guard_decision(guard, payload) != should_deny:
            verb = "did not deny" if should_deny else "wrongly denied"
            fail(f"writespec-guard {verb}: {json.dumps(payload['tool_input'])[:90]}", failures)


def check_spend_guard(failures: list[str]) -> None:
    """Hermetic: cases run against a temp repo via SPEND_GUARD_REPO."""
    guard = ROOT / "tools/spend-guard"
    with tempfile.TemporaryDirectory(prefix="agent-kit-spend-check-") as directory:
        repo = Path(directory)
        ledger = repo / "docs/delegation_spend.md"
        ledger.parent.mkdir(parents=True)
        header = "# ledger\n\n| date | delegation | tokens | where |\n| --- | --- | --- | --- |\n"
        ledger.write_text(header)
        for cmd in (["git", "init", "-q"],
                    ["git", "-c", "user.email=t@t", "-c", "user.name=t", "add", "-A"],
                    ["git", "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "seed"]):
            subprocess.run(cmd, cwd=repo, capture_output=True, check=True)
        env = {**os.environ, "SPEND_GUARD_REPO": str(repo)}

        def case(command: str, should_deny: bool) -> None:
            payload = {"tool_name": "Bash", "tool_input": {"command": command}}
            if guard_decision(guard, payload, env) != should_deny:
                verb = "did not deny" if should_deny else "wrongly denied"
                fail(f"spend-guard {verb}: {command!r}", failures)

        merge = "git merge --ff-only integration/w1"
        case("git commit -F - <<'EOF'\nnote: git merge integration/w1 later\nEOF", False)
        case("git merge implementer-branch", False)
        case("git checkout integration/w1 && git merge implementer-branch", False)
        case(f"{merge}  # [no-ledger]", False)
        case(merge, True)
        ledger.write_text(header + "| soon | W1 | lots | stuff |\n")
        case(merge, True)
        ledger.write_text(header + "| 2026-01-01 | W1 thing | ~38k | spec 6k, tests 22k |\n")
        case(merge, False)


def check_codex_rules(failures: list[str]) -> None:
    rules = sorted((ROOT / ".codex/rules").glob("*.rules"))
    if not rules:
        return
    codex = shutil.which("codex")
    if not codex:
        print("SKIP codex rules: codex CLI not installed")
        return
    for path in rules:
        result = subprocess.run([codex, "execpolicy", "check", "--rules", str(path), "--", "git",
                                 "push"], capture_output=True, text=True, check=False)
        if result.returncode != 0:
            fail(f"{path.relative_to(ROOT)} does not load: {(result.stderr or result.stdout).strip()}",
                 failures)
        elif path.name == "kit.rules" and '"decision":"forbidden"' not in result.stdout.replace(" ", ""):
            fail(f"{path.relative_to(ROOT)} does not forbid `git push`", failures)


def run_plugins(failures: list[str]) -> None:
    for path in sorted((ROOT / "tools").glob("check_agent_setup_*.py")):
        spec = importlib.util.spec_from_file_location(path.stem, path)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        module.check(ROOT, lambda message: fail(message, failures))


def main() -> int:
    failures: list[str] = []
    lock = receipt()
    targets = lock.get("targets", ["agents", "claude"])

    for relative in REQUIRED:
        if not (ROOT / relative).is_file():
            fail(f"missing {relative}", failures)
    if failures:
        return 1

    if not (ROOT / "CLAUDE.md").read_text().startswith("@AGENTS.md\n"):
        fail("CLAUDE.md does not import AGENTS.md first", failures)
    agents_md = (ROOT / "AGENTS.md").read_text()
    for pack in lock.get("packs", []):
        if (ROOT / ".agent-kit.lock").is_file() and f"<!-- kit:begin {pack} -->" in agents_md \
                and f"<!-- kit:end {pack} -->" not in agents_md:
            fail(f"AGENTS.md kit block for {pack} is not closed", failures)

    for relative, loader in ((".codex/config.toml", tomllib.loads), (".claude/settings.json", json.loads),
                             ("opencode.json", json.loads), (".mcp.json", json.loads)):
        path = ROOT / relative
        if path.is_file():
            try:
                loader(path.read_text())
            except (tomllib.TOMLDecodeError, json.JSONDecodeError) as exc:
                fail(f"{relative} does not parse: {exc}", failures)
    try:
        paths = json.loads((ROOT / "opencode.json").read_text()).get("skills", {}).get("paths", [])
        if ".agents/skills" not in paths or ".claude/skills" not in paths:
            fail("opencode.json must register both .agents/skills and .claude/skills", failures)
    except json.JSONDecodeError:
        pass

    try:
        agent_profile.load(ROOT)
    except agent_profile.ProfileError as exc:
        fail(str(exc), failures)

    count = check_skills(targets, failures)

    for relative in EXECUTABLE:
        path = ROOT / relative
        if not path.is_file():
            fail(f"missing {relative}", failures)
        elif not path.stat().st_mode & stat.S_IXUSR:
            fail(f"{relative} is not executable", failures)

    check_writespec_guard(failures)
    check_spend_guard(failures)
    check_codex_rules(failures)
    run_plugins(failures)

    if failures:
        print(f"\n{len(failures)} agent-setup validation failure(s).")
        return 1
    print(f"PASS agent setup: {count} skills mirrored to {', '.join(targets)}; configs, profile, "
          f"guards and packs ({', '.join(lock.get('packs', [])) or 'no receipt'}) valid")
    return 0


if __name__ == "__main__":
    sys.exit(main())
